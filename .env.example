SERVER_ADDRESS=:8080
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=go_coin_hunter
POSTGRES_SSL_MODE=disable
BACKGROUND_JOBS_ENABLED=true
HUNT_PIPELINE_INTERVAL_HOURS=4
SHUTDOWN_GRACE_MINUTES=15
DISCOVERY_WINDOW_HOURS=72
DISCOVERY_EXCLUDED_COIN_SYMBOLS=BTC,ETH,BNB,SOL,XRP,USDT,USDC,FDUSD,DAI,TUSD,USDE
FILTER_MAXIMUM_TAX_RATE=0.1
FILTER_MINIMUM_DAILY_VOLUME_USD=1000000
FILTER_MINIMUM_FDV_USD=10000000
FILTER_MAXIMUM_FDV_USD=3000000000
FILTER_MINIMUM_CIRCULATING_RATIO=0.2
FILTER_UNLOCK_LOOKAHEAD_DAYS=14
FILTER_MAXIMUM_UNLOCK_RATIO=0.05
# Momentum rules (ratios as the exchanges report them: -0.1 is a 10% fall, 0.001 is 0.1%)
FILTER_MINIMUM_PRICE_CHANGE_RATIO=-0.1
FILTER_MAXIMUM_PRICE_CHANGE_RATIO=0.6
FILTER_MINIMUM_OPEN_INTEREST_CHANGE_RATIO=-0.15
# Funding rate ceiling per 8 hours; contracts settling every 1 or 4 hours are scaled to 8 hours first
FILTER_MAXIMUM_FUNDING_RATE=0.001
# Claude API key for the insight step (calls are billed to this key); when empty, every analysis fails and the insight round is marked failed
ANTHROPIC_API_KEY=
INSIGHT_MODEL=claude-opus-5-5
INSIGHT_EFFORT=low
INSIGHT_MAX_CONCURRENT_ANALYSES=3
INSIGHT_MAX_COINS_PER_ROUND=20
VERDICT_MODEL=claude-opus-5-5
VERDICT_EFFORT=high
# Only bullish insights at least this strong (1-10) reach the CIO
VERDICT_MINIMUM_BULLISH_INSIGHT_STRENGTH=6
# Only long verdicts at least this confident (0-100) make the hunt board
HUNT_BOARD_MINIMUM_CONFIDENCE=50
